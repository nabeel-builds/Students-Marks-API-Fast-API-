# Byte-compiled / optimized / DLL files (removes __pycache__)
__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environment
venv/
.venv/
env/
ENV/

# VS Code environment settings
.vscode/

# Local environment variables / secrets (highly recommended for FastAPI)
.env
.env.local
.env.*

# Database files (if you plan to use SQLite locally)
*.sqlite3
*.sqlite3-journal

# OS generated files
.DS_Store
Thumbs.db
